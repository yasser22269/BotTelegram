# Telegram — create a NEW bot with @BotFather (don't reuse the Mustaqbal bot token)
TELEGRAM_TOKEN=
# Your Telegram user ID (send /start to the bot to see it)
ADMIN_ID=
# Optional: extra chats/channels to receive jobs, comma separated (overrides ADMIN_ID)
ALLOWED_CHAT_IDS=

# Upwork API key — https://www.upwork.com/developer/keys
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
# Must match the key's Callback URL exactly
UPWORK_REDIRECT_URI=http://localhost:8888

# Polling
POLL_INTERVAL=60
MAX_JOB_AGE_MINUTES=60
